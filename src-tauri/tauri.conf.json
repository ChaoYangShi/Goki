{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goki",
  "version": "0.2.0",
  "identifier": "com.goki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Goki",
        "width": 190,
        "height": 190,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "hud",
        "title": "Goki Search",
        "width": 680,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "remote",
        "title": "Goki SSH",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Goki 设置",
        "width": 520,
        "height": 430,
        "minWidth": 420,
        "minHeight": 360,
        "visible": false,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
